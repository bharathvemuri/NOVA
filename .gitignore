# Harness working directory. The event log and revised-spec.md are the audit
# trail and belong in version control; the derived view and generated index do not.
.harness/state.json
.harness/index/
.harness/worktrees/

# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
dist-types/
*.tsbuildinfo

# Test / coverage output
coverage/
playwright-report/
test-results/

# Vite
.vite/

# Editor / OS
.DS_Store

# Transient fixtures written by tests/boundaries/lint-boundaries.spec.ts into
# real package src/ directories; removed in afterEach, but ignored too so a
# survivor from a hard process kill can never be committed (plan §9 S3).
**/__eslint_boundary_fixture__.*

# Artifacts written into the worktree root by harness agent stages (Security's
# semgrep run, stage stdout/stderr capture). Never repository content; they
# appear mid-run and would otherwise be committed and fail `prettier --check`
# (Prettier honours .gitignore by default).
/semgrep_out.json
/semgrep_stderr.log
/sec_out.log
/sec_err.log
