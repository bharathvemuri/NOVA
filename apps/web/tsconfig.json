{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist-types",
    "rootDir": "./src",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "emitDeclarationOnly": true,
    "declarationDir": "./dist-types"
  },
  "include": ["src"],
  "references": [{ "path": "../../packages/shared" }, { "path": "../../packages/renderer" }]
}
